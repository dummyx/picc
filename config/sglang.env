# SGLang inference server pins.
#
# This file is the single source of truth for how the local model is served.
# It is read by scripts/sglang_server.sh, not by scripts/common.py: the harness
# configures the *client* (config/defaults.env and .env), this file configures
# the *server*. Both are copied into every study materialization, so each run
# freezes the inference configuration it ran against.
#
# Every value below is a pin taken from SGLang's verified Qwen3.8-27B recipe
# for this exact card. Do not change one without recording the change and its
# measured outcome in docs/INFERENCE_SGLANG.md.
#
# Hardware this is pinned for: NVIDIA GeForce RTX 5090, 32607 MiB, compute
# capability 12.0 (SM120, Blackwell).

# --- Checkpoint -------------------------------------------------------------
# NVFP4 W4A4 body (FP8 attention and GDN projections, NVFP4 MLPs) with the
# lm_head packed to FP4. ~16.5 GB of weights, which is the variant SGLang
# recommends for RTX 5090-class cards; the FP8 checkpoint is ~28.5 GB and is
# "not serviceable beyond bs<=2 on 32GB cards".
SGLANG_MODEL_REPO=RadixArk/Qwen3.8-27B-NVFP4
# Pinned revision. Set by scripts/sglang_server.sh --pin after the first
# download; an empty value means "whatever main resolves to", which is not
# reproducible and is refused by `sglang_server.sh serve --strict`.
SGLANG_MODEL_REVISION=319f741cce68d7914884900c138a1fbb70a42f30
# Where scripts/fetch_model.sh puts the checkpoint, and what --model-path
# points at. Kept outside the repository: it is ~21.9 GB and is not the kind
# of artefact a run directory should hold. Empty means $HOME/models/<name>.
SGLANG_MODEL_DIR=
# The name the server reports on /v1/models and /get_model_info. MODEL_ID in
# .env must equal this exactly or preflight fails. Pinning it separately from
# --model-path keeps run metadata stable even when the path is a local
# snapshot directory.
SGLANG_SERVED_MODEL_NAME=RadixArk/Qwen3.8-27B-NVFP4

# --- Endpoint ---------------------------------------------------------------
# Loopback only. Containers reach it through LOCAL_NETWORK_MODE=host because
# the host firewall blocks the Docker bridge. Do not bind 0.0.0.0 without
# deciding that deliberately: it exposes an unauthenticated-by-default server.
SGLANG_HOST=127.0.0.1
SGLANG_PORT=30000

# --- Context ----------------------------------------------------------------
# The checkpoint's native context is 262144, far more than this card's KV pool
# can hold. Pinning it makes the ceiling explicit instead of letting SGLang
# advertise 262144 and fail at request time. This must be >= the harness's
# LOCAL_CONTEXT_WINDOW; `sglang_server.sh check` verifies that.
SGLANG_CONTEXT_LENGTH=131072

# --- Verified RTX 5090 flags ------------------------------------------------
# These are the SGLang cookbook's measured cell for
# hw=rtx5090 / quant=nvfp4-fp4-head / spec=none / nodes=single, which served
# and scored 93.93-94.92% on the full 1319-question GSM8K on v0.5.19.
#
#   --mem-fraction-static 0.9   the no-speculation operating point for this card
#   --attention-backend flashinfer   trtllm_mha is SM100-only; SM120 needs this
#   --kv-cache-dtype fp8_e4m3   ~2x KV savings, using the checkpoint's own scales
#   --max-running-requests 1    the validated single-stream envelope, and also
#                               exactly what this harness needs: one Pi session
#   --cuda-graph-max-bs-decode 1   pinned with it; raise both together or not
#   --reasoning-parser qwen3    without it, thinking is not split out
#   --tool-call-parser qwen3_coder   this template emits <function=...> nested
#                               in <tool_call>; the `hermes` parser reads bare
#                               JSON and would silently fail to parse any call
# 0.85 rather than the cookbook's 0.9. At 0.9 the weights, the GDN state pool
# and the KV pool between them left 3.10 GB, and CUDA graph capture then died
# with "CUDA error: out of memory" (followed by a PyTorch internal assert about
# markCaptureEnd, which is the capture failure surfacing badly, not the cause).
# The cookbook's 0.9 is for their measured cell; this build carries a vision
# tower and its multimodal allocations on the same 32 GB.
SGLANG_MEM_FRACTION_STATIC=0.85
SGLANG_ATTENTION_BACKEND=flashinfer
SGLANG_KV_CACHE_DTYPE=fp8_e4m3
SGLANG_MAX_RUNNING_REQUESTS=1
SGLANG_CUDA_GRAPH_MAX_BS_DECODE=1
SGLANG_REASONING_PARSER=qwen3
SGLANG_TOOL_CALL_PARSER=qwen3_coder

# --- Overlays chosen for this workload --------------------------------------
# bfloat16 GDN state: one state slot is 78.4 MB at bf16 against 153.9 MB at
# float32, and the difference goes to KV. Measured by SGLang on an RTX 5090
# with no speculation: 97280 KV tokens at bf16 against 68588 at float32. This
# harness needs the longest context it can get, so bf16 is the right trade.
SGLANG_MAMBA_SSM_DTYPE=bfloat16
# extra_buffer_lazy costs 4 state slots per running request instead of 5, at
# no accuracy cost. On a 32 GB card the state pool, not KV, is the binding
# constraint, so the cheaper strategy is preferred.
SGLANG_MAMBA_RADIX_CACHE_STRATEGY=extra_buffer_lazy
# The GDN state pool sizes itself for concurrency this server will never see:
# left alone it allocated 45 slots (3.23 GB of ssm_state) when one request at
# 4 slots per request needs four. The cookbook's own rule is
# `--max-mamba-cache-size = target_concurrency x S`; 16 is that with room to
# spare, and the difference goes to the KV pool instead of sitting idle.
SGLANG_MAX_MAMBA_CACHE_SIZE=16

# --- Strict thinking --------------------------------------------------------
# Off by default, because turning it on changes what the model does and that
# is an experimental decision, not a serving one.
#
# With --enable-strict-thinking the server builds a reasoner grammar that can
# force the end-of-thinking token once a request's thinking budget is spent.
# The budget is per request: `custom_params: {"thinking_budget": N}` on a
# /v1/chat/completions call, which is reachable from Pi through models.json
# samplingParams (LOCAL_SAMPLING_PARAMS in .env).
#
# Why this matters here: under llama.cpp the only control over thinking was
# the output cap, and a reply that reached the cap while still reasoning
# produced no text and no tool call at all. That happened to 62% of replies in
# the strict-typing condition against 3-10% elsewhere, and raising the cap did
# not help -- the reasoning expanded to fill whatever budget it was given
# (report section 18). A thinking budget bounds the reasoning directly and
# leaves the rest of the output cap for the answer, which is the first control
# available that addresses the cause rather than the symptom.
SGLANG_ENABLE_STRICT_THINKING=1

# --- Speculative decoding ---------------------------------------------------
# Off. The in-checkpoint MTP head (EAGLE 3/1/4) and the DSpark/DFlash2 drafts
# all cost VRAM that this card would have to take from the KV pool, and the
# experiment is bound by context length, not by tokens per second. Leaving it
# off is also the only RTX 5090 row that needs no --mamba-full-memory-ratio or
# --max-total-tokens pinning ("the no-speculation row needs none of it and
# runs at the pins shown").
SGLANG_SPECULATIVE_ALGORITHM=

# --- First-launch kernel build ----------------------------------------------
# SGLang and FlashInfer JIT-compile kernels for this GPU the first time they
# are needed, and cache them under ~/.cache/sglang. Left to itself the build
# runs one compiler per core. The CUTLASS FP4 kernels are template-heavy and
# each nvcc takes several GB, so on this 30 GB host that gets the whole build
# killed by the OOM killer: ninja reports "FAILED: [code=137]" for a dozen
# object files and the server exits during startup with no other explanation.
SGLANG_BUILD_JOBS=4

# --- Process ----------------------------------------------------------------
# Where the launcher keeps its venv, logs, and per-launch configuration record.
SGLANG_VENV=.venv-sglang
SGLANG_LOG_DIR=runs/inference
