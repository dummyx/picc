# Reproducibility pins
STARTER_VERSION=0.1.0
PI_VERSION=0.85.1
# Pi package that gives the bash tool a default timeout (120 s when the agent
# sets none; an explicit timeout always wins). Pi itself ships no default and
# its maintainer declined one (earendil-works/pi#2987), so the package is
# pinned in the image and loaded through pi/settings.json. Image 0.4 differs
# from 0.3 only by this package.
BASH_TIMEOUT_PACKAGE=@cad0p/pi-bash-timeout
BASH_TIMEOUT_PACKAGE_VERSION=0.1.0
# mypy in a venv at /opt/mypy (on PATH) for the typed-Python candidate
# condition (`python3 -m` is not used: mypy lives outside the system
# site-packages). Image 0.5 differs from 0.4 only by this venv.
MYPY_VERSION=2.3.1
RUST_TOOLCHAIN=1.88.0
# TypeScript compiler and Node type declarations installed globally in the
# image for the static-typing candidate conditions (studies/types/study.json).
# Image 0.2 differs from 0.1 only by these two npm packages; image 0.3 differs
# from 0.2 only by the Pi version (0.84.1 -> 0.85.1); image 0.4 adds the
# bash-timeout package above.
TYPESCRIPT_VERSION=5.9.3
NODE_TYPES_VERSION=24.13.3
# Base image pinned by digest (the 24.20.0 tag image 0.2 was built from). A
# floating tag moved the Node patch level between images 0.1 and 0.2.
NODE_IMAGE=node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e
DOCKER_PLATFORM=linux/amd64
EXPERIMENT_IMAGE=picc-experiment:0.5

# Provider selection. MODEL_PROVIDER/MODEL_ID/MODEL_THINKING are the frozen
# provider, model ID, and thinking level passed to Pi for every profile.
# No model is assumed: set MODEL_PROVIDER and MODEL_ID in .env before any run,
# or the harness refuses to start rather than guessing a model.
# Supported providers: Pi built-in "zai" and "zai-coding-cn" Coding Plan
# providers, or "local" for a self-hosted OpenAI-compatible endpoint.
MODEL_PROVIDER=
MODEL_ID=
MODEL_THINKING=max

# Local endpoint shape, used only when MODEL_PROVIDER=local. The values are
# frozen into control/pi/models.json and metadata.json for each run, and they
# describe the *client* side. The server side is config/sglang.env, and the two
# must agree: MODEL_ID equals SGLANG_SERVED_MODEL_NAME, LOCAL_BASE_URL points
# at SGLANG_HOST/SGLANG_PORT, and LOCAL_CONTEXT_WINDOW fits in the pool the
# server actually allocates. `make preflight` checks all three.
# See docs/INFERENCE_SGLANG.md. LOCAL_API_KEY belongs in .env.
LOCAL_BASE_URL=http://host.docker.internal:8080/v1
LOCAL_API=openai-completions
LOCAL_CONTEXT_WINDOW=131072
# Maximum output tokens per request (models.json maxTokens). The key avoids
# the TOKEN substring because *KEY*/*TOKEN* configuration is scrubbed as secret.
LOCAL_MAX_OUTPUT=32768
LOCAL_REASONING=1
LOCAL_THINKING_FORMAT=qwen-chat-template
# Maps Pi's thinking levels (minimal/low/medium/high/xhigh/max, plus off) onto
# the values the served model expects; empty means pass each level through
# unchanged. Only consulted when LOCAL_COMPAT sets supportsReasoningEffort.
#
# Qwen3.8's chat template accepts 'low', 'medium' and 'xhigh' and raises an
# exception on anything else, defaulting to 'xhigh' when nothing is sent. So
# an identity map plus supportsReasoningEffort would fail every request at
# MODEL_THINKING=high or max. A map for that model would be, for example:
#   LOCAL_THINKING_LEVEL_MAP='{"minimal":"low","low":"low","medium":"medium","high":"xhigh","xhigh":"xhigh","max":"xhigh"}'
LOCAL_THINKING_LEVEL_MAP=
LOCAL_SAMPLING_PARAMS=
# Network mode for containers that must reach the local endpoint: "bridge"
# (default) maps host.docker.internal to the host gateway; "host" shares the
# host network namespace so LOCAL_BASE_URL may target 127.0.0.1 (use when
# host firewalling blocks traffic from the docker bridge).
LOCAL_NETWORK_MODE=bridge
LOCAL_COMPAT='{"supportsDeveloperRole": false, "supportsReasoningEffort": false, "maxTokensField": "max_tokens"}'

# Test corpus and deterministic split
TEST_REPOSITORY=https://github.com/nlsandler/writing-a-c-compiler-tests.git
TEST_REF=ae12014d2dec14488f3f80d14df4b6d8e4634d7d
TEST_MAX_STAGE=10
SPLIT_SEED=20260810
VISIBLE_FRACTION=0.70

# Chapters 1-18 compiler task (studies/c18): same upstream revision, wider
# scope (`split_tests.py --scope core-with-fixtures`), its own split seed and
# partitions under data/partitions-c18. The chapters 1-10 split above is
# untouched. Selection pinned in studies/c18/selection.json.
C18_MAX_STAGE=18
C18_SPLIT_SEED=20260916

# SQL query engine task (studies/sql): sqllogictest corpus pinned by git
# revision, scripts listed in studies/sql/selection.json, partitions under
# data/partitions-sql. SQLITE_VERSION is the SQLite library of the pinned
# image's python3 (the reference for expected results); the evaluator
# refuses to score under any other version.
SQLLOGICTEST_REPOSITORY=https://github.com/gregrahn/sqllogictest.git
SQLLOGICTEST_REF=c67f97bf3ca7e590d12e073408bcacaf2ff0f3a0
SQL_SPLIT_SEED=20260916
SQLITE_VERSION=3.40.1

# Container limits
AGENT_CPUS=8
AGENT_MEMORY=16g
AGENT_PIDS=512

# Pilot profile (infrastructure/feasibility; do not report as a main result)
PILOT_HOURS=2
PILOT_ROUNDS=6
PILOT_ROUND_TIMEOUT_MINUTES=45
PILOT_MAX_STAGE=6

# Main profile
MAIN_HOURS=12
MAIN_ROUNDS=30
MAIN_ROUND_TIMEOUT_MINUTES=60
MAIN_MAX_STAGE=10

# Fuzz oracle for the final snapshot (post-hoc hidden evaluation): programs per
# stage (0 disables), seed base (stage s uses base + s), per-program run and
# per-program candidate-compile timeouts, and a wall-clock deadline after
# which unreached stages score 0. See studies/runtime/fuzz_evaluate.py.
FUZZ_STAGE_PROGRAMS=100
FUZZ_SEED_BASE=20260830
FUZZ_RUN_TIMEOUT_SECONDS=3
FUZZ_COMPILE_TIMEOUT_SECONDS=10
FUZZ_DEADLINE_SECONDS=5400

# Stop after this many additional rounds once visible score reaches 1.0
PERFECT_VISIBLE_REVIEW_ROUNDS=1

# A round killed at its timeout is snapshotted and followed by another round;
# the run ends only after this many consecutive stalls. Prevents one runaway
# child process from ending a run that still has budget left. Since v11 a
# capped round that changed the workspace is not a stall: it is the agent
# working through its round (report 16.4).
MAX_CONSECUTIVE_ROUND_TIMEOUTS=2

# A round whose context-overflow recovery failed, with no tool call and no
# workspace change, is dead: Pi cannot summarize the session, so every later
# round repeats it. The run ends after this many consecutive dead rounds
# instead of spending its budget on them (v10, report 16.4).
MAX_CONSECUTIVE_DEAD_ROUNDS=2
