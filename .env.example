# Copy this file to .env and declare exactly one provider and one model.
# The harness assumes no model: MODEL_PROVIDER and MODEL_ID must both be set,
# or every command refuses to start rather than guessing.
# Use a dedicated experiment key when possible. Never commit .env.

# --- Option 1: Z.AI Coding Plan, global endpoint ---
# MODEL_PROVIDER=zai
# MODEL_ID=
# MODEL_THINKING=max
# ZAI_API_KEY=

# --- Option 2: Z.AI Coding Plan, China endpoint ---
# MODEL_PROVIDER=zai-coding-cn
# MODEL_ID=
# MODEL_THINKING=max
# ZAI_CODING_CN_API_KEY=

# --- Option 3: local OpenAI-compatible endpoint ---
# Any llama.cpp / LM Studio / vLLM / Ollama server. No hosted key is required.
# MODEL_ID must name the served checkpoint; it is the run's provenance label.
# See "Using a local model" in README.md.
# MODEL_PROVIDER=local
# MODEL_ID=vendor/your-served-model
# MODEL_THINKING=high
# LOCAL_BASE_URL=http://host.docker.internal:8080/v1
# LOCAL_CONTEXT_WINDOW=131072
# LOCAL_API_KEY=
# Use LOCAL_NETWORK_MODE=host, with a loopback LOCAL_BASE_URL, when host
# firewalling blocks the docker bridge from reaching the endpoint.
# LOCAL_NETWORK_MODE=bridge
#
# This project serves its own model with SGLang (make sglang-install,
# scripts/fetch_model.sh, make sglang-start; see docs/INFERENCE_SGLANG.md).
# For that setup the values are:
# MODEL_PROVIDER=local
# MODEL_ID=RadixArk/Qwen3.8-27B-NVFP4      # = SGLANG_SERVED_MODEL_NAME
# LOCAL_BASE_URL=http://127.0.0.1:30000/v1
# LOCAL_NETWORK_MODE=host
# LOCAL_SAMPLING_PARAMS='{"temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0}'
# Hard cap on reasoning tokens per reply; needs SGLANG_ENABLE_STRICT_THINKING=1
# in config/sglang.env or it is silently ignored. Must be below LOCAL_MAX_OUTPUT.
# LOCAL_THINKING_BUDGET=8192
#
# Keep this file private (chmod 600 .env): it holds the endpoint's API key.

# Optional overrides. Defaults are in config/defaults.env.
# EXPERIMENT_IMAGE=picc-experiment:0.2
# PILOT_HOURS=2
# MAIN_HOURS=12
