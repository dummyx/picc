# Copy this file to .env and set exactly one Coding Plan key.
# Use a dedicated experiment key when possible. Never commit .env.

# Global Z.AI Coding Plan:
ZAI_API_KEY=

# China Coding Plan alternative:
# MODEL_PROVIDER=zai-coding-cn
# ZAI_CODING_CN_API_KEY=

# Local OpenAI-compatible endpoint instead of a hosted Coding Plan
# (example: llama.cpp serving unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL).
# See "Using a local model" in README.md. No hosted key is required.
# MODEL_PROVIDER=local
# MODEL_ID=unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL
# MODEL_THINKING=high
# LOCAL_BASE_URL=http://host.docker.internal:8080/v1
# LOCAL_CONTEXT_WINDOW=131072
# LOCAL_API_KEY=

# Optional overrides. Defaults are in config/defaults.env.
# EXPERIMENT_IMAGE=picc-pi-glm52:0.1
# MODEL_ID=glm-5.2
# MODEL_THINKING=max
# PILOT_HOURS=2
# MAIN_HOURS=12
