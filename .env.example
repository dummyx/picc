# Copy this file to .env, then `chmod 600 .env`: it holds the model server's
# API key. Never commit it.
#
# Declare exactly one provider and one model. The harness assumes no model:
# with MODEL_PROVIDER or MODEL_ID empty, every command refuses to start rather
# than guessing. Everything not set here comes from config/defaults.env, and a
# study condition may override budgets on top. Values are read literally: do
# not put a comment on the same line as a value.

# --- The local SGLang server this project uses (docs/INFERENCE_SGLANG.md) ---
# MODEL_ID must equal SGLANG_SERVED_MODEL_NAME in config/sglang.env, and
# LOCAL_BASE_URL must point at SGLANG_HOST:SGLANG_PORT; `make preflight`
# checks both. LOCAL_NETWORK_MODE=host lets the containers reach a loopback
# address, which the host firewall hides from the Docker bridge.
MODEL_PROVIDER=local
MODEL_ID=RadixArk/Qwen3.8-27B-NVFP4
MODEL_THINKING=high
LOCAL_BASE_URL=http://127.0.0.1:30000/v1
LOCAL_NETWORK_MODE=host
LOCAL_API_KEY=
LOCAL_CONTEXT_WINDOW=131072
LOCAL_MAX_OUTPUT=32768
LOCAL_SAMPLING_PARAMS='{"temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0}'
# Hard cap on reasoning tokens per reply. It needs
# SGLANG_ENABLE_STRICT_THINKING=1 in config/sglang.env or it is silently
# ignored, and it must be below LOCAL_MAX_OUTPUT.
LOCAL_THINKING_BUDGET=8192

# --- Budgets used by the recent batches (defaults: 12 hours, 60-minute rounds)
MAIN_HOURS=2
MAIN_ROUND_TIMEOUT_MINUTES=45

# --- Any other OpenAI-compatible endpoint (llama.cpp, vLLM, LM Studio, ...) ---
# Set the LOCAL_* values above to match it, and skip the sglang-* targets.
# LOCAL_NETWORK_MODE=bridge (the default) reaches it as host.docker.internal.

# --- Hosted Z.AI Coding Plan instead of a local model ---
# Provider zai uses ZAI_API_KEY; provider zai-coding-cn uses
# ZAI_CODING_CN_API_KEY. MODEL_ID is the hosted model's exact name.
# MODEL_PROVIDER=zai
# MODEL_ID=
# MODEL_THINKING=max
# ZAI_API_KEY=
