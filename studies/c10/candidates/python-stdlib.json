{
  "schema_version": 1,
  "language": "python",
  "framework": "standard-library",
  "dependency_policy": "Python standard library only; no package installation",
  "build": {
    "command": [
      "python3",
      "-m",
      "py_compile",
      "picc.py"
    ],
    "artifact": "picc.py",
    "timeout_seconds": 300
  },
  "run": {
    "command": [
      "python3",
      "{artifact}",
      "{input}",
      "-o",
      "{output}"
    ]
  },
  "source_extensions": [
    ".py"
  ],
  "audit": {
    "python_stdlib_only": true,
    "allowed_python_modules": []
  },
  "spec_variables": {
    "LANGUAGE": "Python 3",
    "FRAMEWORK": "Python standard library only",
    "DEPENDENCY_POLICY": "Python standard library only; do not install packages",
    "BUILD_COMMAND": "python3 -m py_compile picc.py",
    "ENTRY_COMMAND": "python3 picc.py INPUT.c -o OUTPUT.s"
  }
}
