import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { appendFileSync, mkdirSync } from "node:fs";
import { dirname, isAbsolute, resolve, sep } from "node:path";

const WORKSPACE = resolve(process.env.PICC_WORKSPACE ?? "/workspace");
const VISIBLE_TESTS = resolve(process.env.PICC_VISIBLE_TESTS ?? "/visible-tests");
const REFERENCE = resolve(VISIBLE_TESTS, "reference");
const AUDIT_PATH = process.env.PICC_GUARD_LOG ?? "/run-artifacts/guard.jsonl";
// Per-command wall-clock cap for the bash tool, in seconds (0 or unset disables
// it). Pi's bash tool has no default timeout, so a program that the candidate
// compiler miscompiled into an infinite loop blocks the session for the rest of
// the round when the agent runs it. The cap is part of the fixed environment:
// the harness sets it identically for every condition. A shorter timeout the
// agent requests is honored; a longer one is clamped.
const BASH_TIMEOUT_SECONDS = Number(process.env.PICC_BASH_TIMEOUT_SECONDS ?? "0");
const BASH_TIMEOUT_MESSAGE = /Command timed out after (\d+(?:\.\d+)?) seconds/;
const ALLOW_TEST_FILES = __ALLOW_TEST_FILES__;
const ALLOW_REFERENCE_FILES = __ALLOW_REFERENCE_FILES__;
// Candidate-adapter bash blocks: commands the frozen candidate policy withholds
// in this condition (for example a static type checker in an untyped arm).
const CANDIDATE_BLOCKED_BASH_PATTERNS = __CANDIDATE_BLOCKED_BASH_PATTERNS__ as Array<{
  pattern: string;
  reason: string;
}>;

function inside(path: string, root: string): boolean {
  return path === root || path.startsWith(root + sep);
}

function absolutePath(raw: unknown): string | undefined {
  if (typeof raw !== "string" || raw.trim() === "") return undefined;
  return resolve(isAbsolute(raw) ? raw : resolve(WORKSPACE, raw));
}

function audit(record: Record<string, unknown>): void {
  try {
    mkdirSync(dirname(AUDIT_PATH), { recursive: true });
    appendFileSync(
      AUDIT_PATH,
      JSON.stringify({ timestamp: new Date().toISOString(), ...record }) + "\n",
      "utf8",
    );
  } catch {
    // Guard logging must not terminate Pi.
  }
}

function applyBashTimeout(input: { timeout?: unknown }, toolCallId: string, command: string): void {
  if (!(BASH_TIMEOUT_SECONDS > 0)) return;
  const requested = input.timeout;
  let applied = BASH_TIMEOUT_SECONDS;
  if (typeof requested === "number" && Number.isFinite(requested) && requested > 0) {
    applied = Math.min(requested, BASH_TIMEOUT_SECONDS);
  }
  if (requested !== undefined && applied !== requested) {
    audit({
      event: "bash_timeout_clamped",
      toolName: "bash",
      toolCallId,
      requested,
      applied,
      subject: command,
    });
  }
  input.timeout = applied;
}

function protectedWrite(path: string): string | undefined {
  if (!inside(path, WORKSPACE)) return "writes are restricted to /workspace";
  const protectedPaths = [
    resolve(WORKSPACE, "AGENTS.md"),
    resolve(WORKSPACE, "TASK.md"),
    resolve(WORKSPACE, "SPEC.md"),
    resolve(WORKSPACE, ".pi"),
    resolve(WORKSPACE, ".git"),
  ];
  if (protectedPaths.some((root) => inside(path, root))) {
    return "experiment-control and Git metadata are read-only";
  }
  return undefined;
}

function restrictedRead(path: string): string | undefined {
  if (inside(path, WORKSPACE)) return undefined;
  if (ALLOW_TEST_FILES && inside(path, VISIBLE_TESTS)) return undefined;
  if (ALLOW_REFERENCE_FILES && inside(path, REFERENCE)) return undefined;
  return "reads are restricted by this condition's test/reference access policy";
}

function visiblePathReason(command: string): string | undefined {
  const normalized = command
    .replaceAll(/(?:\.\.\/|\.\/)+visible-tests/g, "/visible-tests")
    .replaceAll(/(^|[\s;&|])visible-tests(?=\/|[\s;&|]|$)/g, "$1/visible-tests");
  if (!normalized.includes("/visible-tests")) return undefined;
  if (ALLOW_TEST_FILES) return undefined;
  if (!ALLOW_REFERENCE_FILES) return "direct access to visible test files is withheld";

  const remainder = normalized.replaceAll(/\/visible-tests\/reference(?:\/[^\s;&|]*)?/g, "");
  if (remainder.includes("/visible-tests")) {
    return "only /visible-tests/reference is exposed in this condition";
  }
  return undefined;
}

const bashBlocks: Array<{ pattern: RegExp; reason: string }> = [
  {
    pattern: /(^|[;&|]\s*)(?:\/[^\s;&|]+\/)?(?:curl|wget|aria2c|ftp|sftp|ssh|scp|nc|ncat|socat)(?=\s|$)/i,
    reason: "network/download command is prohibited",
  },
  {
    pattern: /\bgit\s+(?:clone|fetch|pull|submodule|remote)\b/i,
    reason: "retrieving external repository content is prohibited",
  },
  {
    pattern: /\b(?:apt|apt-get|apk|dnf|yum|pacman|brew)\b/i,
    reason: "system package installation is prohibited",
  },
  {
    pattern: /\b(?:pip|pip3|uv|npm|pnpm|yarn|bun)\s+(?:install|add|update|upgrade|x|dlx)\b/i,
    reason: "dependency download or installation is prohibited",
  },
  {
    pattern: /\bcargo\s+(?:add|install|search|update|login|publish)\b/i,
    reason: "Cargo network/package mutation is prohibited",
  },
  {
    pattern: /\/opt\/picc-eval(?:\/|\b)/i,
    reason: "direct evaluator execution is prohibited; use the condition-controlled tools",
  },
  {
    pattern: /(^|[;&|]\s*)(?:\/[^\s;&|]+\/)?(?:gcc|g\+\+|clang|clang\+\+|cc|c\+\+|tcc|cpp|c99|c11|zig\s+cc)(?=\s|$)/i,
    reason: "direct use of an existing C/C++ compiler is prohibited; use the experimental tools",
  },
  {
    pattern: /(^|[;&|]\s*)(?:printenv(?:\s+[A-Za-z_][A-Za-z0-9_]*)?|env|set|export\s+-p)\s*(?=$|[;&|])/i,
    reason: "credential/environment inspection is prohibited",
  },
  {
    pattern: /(?:\/proc(?:\/[^\s]*)?\/environ|ZAI_API_KEY|ZAI_CODING_CN_API_KEY|LOCAL_API_KEY|auth\.json|\/run-artifacts)/i,
    reason: "credential or harness-internal access is prohibited",
  },
  {
    pattern: /(?:https?:\/\/|\b(?:requests|urllib|httpx|node-fetch)\b|\bfetch\s*\()/i,
    reason: "programmatic network access is prohibited",
  },
  {
    pattern: /(?:^|[;&|]\s*)(?:rm|mv|cp|install|chmod|chown|truncate|tee)(?:\s+[^;&|]*)?(?:AGENTS\.md|TASK\.md|SPEC\.md|\/visible-tests|\/opt\/picc-eval|\/run-artifacts|\/workspace\/\.pi)/i,
    reason: "mutation of experiment-control files is prohibited",
  },
  ...CANDIDATE_BLOCKED_BASH_PATTERNS.map((row) => ({
    pattern: new RegExp(row.pattern, "i"),
    reason: row.reason,
  })),
];

export default function experimentGuard(pi: ExtensionAPI) {
  pi.on("tool_call", async (event) => {
    let reason: string | undefined;
    let subject: unknown;

    if (event.toolName === "bash") {
      const command = (event.input as { command?: unknown }).command;
      subject = command;
      if (typeof command !== "string") {
        reason = "bash command must be a string";
      } else {
        reason = bashBlocks.find(({ pattern }) => pattern.test(command))?.reason;
        reason ??= visiblePathReason(command);
        if (!reason) applyBashTimeout(event.input as { timeout?: unknown }, event.toolCallId, command);
      }
    } else if (event.toolName === "write" || event.toolName === "edit") {
      const rawPath = (event.input as { path?: unknown }).path;
      subject = rawPath;
      const path = absolutePath(rawPath);
      reason = path ? protectedWrite(path) : "missing or invalid path";
    } else if (["read", "grep", "find", "ls"].includes(event.toolName)) {
      const rawPath = (event.input as { path?: unknown }).path ?? WORKSPACE;
      subject = rawPath;
      const path = absolutePath(rawPath);
      reason = path ? restrictedRead(path) : "missing or invalid path";
    }

    if (!reason) return undefined;
    audit({
      event: "blocked_tool_call",
      toolName: event.toolName,
      toolCallId: event.toolCallId,
      reason,
      subject,
    });
    return { block: true, reason: `Experiment guard: ${reason}` };
  });

  // A command the cap cut off returns an error result whose text ends with
  // Pi's timeout status line; record it so reports can count hangs prevented.
  pi.on("tool_result", async (event) => {
    if (event.toolName !== "bash" || !event.isError) return undefined;
    const text = event.content.map((part) => (part.type === "text" ? part.text : "")).join("\n");
    const match = BASH_TIMEOUT_MESSAGE.exec(text);
    if (!match) return undefined;
    audit({
      event: "bash_timeout_fired",
      toolName: "bash",
      toolCallId: event.toolCallId,
      timeout: Number(match[1]),
      subject: (event.input as { command?: unknown }).command,
    });
    return undefined;
  });
}
