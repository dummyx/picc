import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { Type } from "typebox";
import {
  appendFileSync,
  mkdirSync,
  readFileSync,
  renameSync,
  writeFileSync,
} from "node:fs";
import { dirname } from "node:path";
import { spawn } from "node:child_process";

const ARTIFACTS = process.env.PICC_ARTIFACTS ?? "/run-artifacts";
const STATE_PATH = process.env.PICC_RUN_STATE ?? `${ARTIFACTS}/state.json`;
const EVENT_PATH = `${ARTIFACTS}/extension-events.jsonl`;
const MAX_STAGE = Number.parseInt(process.env.PICC_MAX_STAGE ?? "10", 10);
const TEST_ACCESS = __TEST_ACCESS__ as "none" | "tool" | "files";
const FEEDBACK_MODE = __FEEDBACK_MODE__ as "none" | "aggregate" | "failures" | "detailed";
const REFERENCE_MODE = __REFERENCE_MODE__ as "none" | "oracle" | "source";
const ORACLE_LIMIT = __ORACLE_LIMIT__;
const ORACLE_COUNT_PATH = `${ARTIFACTS}/oracle-count.json`;

function appendEvent(record: Record<string, unknown>): void {
  try {
    mkdirSync(dirname(EVENT_PATH), { recursive: true });
    appendFileSync(
      EVENT_PATH,
      JSON.stringify({ timestamp: new Date().toISOString(), ...record }) + "\n",
      "utf8",
    );
  } catch {
    // Observability must not terminate the agent process.
  }
}

function atomicJson(path: string, value: unknown): void {
  mkdirSync(dirname(path), { recursive: true });
  const temporary = `${path}.${process.pid}.tmp`;
  writeFileSync(temporary, JSON.stringify(value, null, 2) + "\n", "utf8");
  renameSync(temporary, path);
}

async function run(
  command: string,
  args: string[],
  signal?: AbortSignal,
  timeoutMs = 15 * 60 * 1000,
): Promise<{ code: number; stdout: string; stderr: string }> {
  return await new Promise((resolve, reject) => {
    const child = spawn(command, args, {
      cwd: "/workspace",
      env: process.env,
      stdio: ["ignore", "pipe", "pipe"],
    });

    let stdout = "";
    let stderr = "";
    const maxBytes = 8 * 1024 * 1024;
    child.stdout.setEncoding("utf8");
    child.stderr.setEncoding("utf8");
    child.stdout.on("data", (chunk: string) => {
      if (stdout.length < maxBytes) stdout += chunk.slice(0, maxBytes - stdout.length);
    });
    child.stderr.on("data", (chunk: string) => {
      if (stderr.length < maxBytes) stderr += chunk.slice(0, maxBytes - stderr.length);
    });

    const timer = setTimeout(() => {
      child.kill("SIGTERM");
      setTimeout(() => child.kill("SIGKILL"), 2000).unref();
    }, timeoutMs);
    const abort = () => child.kill("SIGTERM");
    signal?.addEventListener("abort", abort, { once: true });

    child.on("error", (error) => {
      clearTimeout(timer);
      signal?.removeEventListener("abort", abort);
      reject(error);
    });
    child.on("close", (code) => {
      clearTimeout(timer);
      signal?.removeEventListener("abort", abort);
      resolve({ code: code ?? 128, stdout, stderr });
    });
  });
}

type EvaluationSummary = {
  score?: number;
  micro_score?: number;
  passed?: number;
  failed?: number;
  total?: number;
  build_ok?: boolean;
  audit_ok?: boolean;
  stages?: Record<
    string,
    {
      score?: number;
      passed?: number;
      total?: number;
      valid?: { passed?: number; total?: number; score?: number };
      invalid?: { passed?: number; total?: number; score?: number };
    }
  >;
  failures?: Array<{
    id?: string;
    stage?: number;
    validity?: string;
    failure_type?: string;
    detail?: string;
  }>;
  error?: string;
};

function headline(summary: EvaluationSummary): string {
  return (
    `Visible evaluation: macro=${Number(summary.score ?? 0).toFixed(4)}, ` +
    `micro=${Number(summary.micro_score ?? 0).toFixed(4)}, ` +
    `passed=${summary.passed ?? 0}/${summary.total ?? 0}, ` +
    `build_ok=${Boolean(summary.build_ok)}, audit_ok=${Boolean(summary.audit_ok)}`
  );
}

function renderSummary(summary: EvaluationSummary, outputPath: string): string {
  const lines = [headline(summary)];
  if (FEEDBACK_MODE === "aggregate") {
    if (summary.error) lines.push(`Evaluator error: ${summary.error}`);
    lines.push("This condition exposes aggregate feedback only; per-stage and per-test failures are withheld.");
  } else if (summary.stages) {
    for (const [stage, row] of Object.entries(summary.stages)) {
      lines.push(
        `  stage ${stage}: score=${Number(row.score ?? 0).toFixed(4)}, ` +
          `passed=${row.passed ?? 0}/${row.total ?? 0}`,
      );
    }
  }

  if (FEEDBACK_MODE === "failures" || FEEDBACK_MODE === "detailed") {
    const failures = summary.failures ?? [];
    if (failures.length > 0) {
      lines.push("Representative failures:");
      for (const failure of failures.slice(0, 8)) {
        const detail =
          FEEDBACK_MODE === "detailed" && failure.detail
            ? ` - ${failure.detail.slice(0, 500)}`
            : "";
        lines.push(
          `  - ${failure.id ?? "unknown"}: ${failure.failure_type ?? "failed"}${detail}`,
        );
      }
    }
  }
  if (summary.error && FEEDBACK_MODE !== "aggregate") lines.push(`Evaluator error: ${summary.error}`);
  lines.push(`Full result retained by the harness at ${outputPath}; do not inspect or edit it.`);
  return lines.join("\n");
}

function readOracleCount(): number {
  try {
    const value = JSON.parse(readFileSync(ORACLE_COUNT_PATH, "utf8")) as { count?: unknown };
    return typeof value.count === "number" && Number.isInteger(value.count) ? value.count : 0;
  } catch {
    return 0;
  }
}

export default function experimentTools(pi: ExtensionAPI) {
  pi.registerTool({
    name: "test_visible",
    label: "Run visible PiCC tests",
    description:
      TEST_ACCESS === "none"
        ? "Visible behavioral tests are unavailable in this experimental condition."
        : "Build the candidate and run the controlled visible behavioral tests with condition-specific feedback.",
    promptSnippet:
      TEST_ACCESS === "none"
        ? "Visible tests unavailable"
        : `Run visible tests (${FEEDBACK_MODE} feedback)`,
    promptGuidelines:
      TEST_ACCESS === "none"
        ? ["Do not repeatedly call this tool; tests are intentionally unavailable in this condition."]
        : [
            "Use the visible evaluator after meaningful changes; prefer a focused stage before a broad run.",
            "Do not invoke an external C compiler directly; the evaluator owns reference assembly and linking.",
          ],
    parameters: Type.Object({
      stage: Type.Optional(Type.Integer({ minimum: 1, maximum: 10 })),
      latestOnly: Type.Optional(Type.Boolean()),
      testId: Type.Optional(Type.String({ maxLength: 500 })),
    }),
    async execute(toolCallId, params, signal) {
      if (TEST_ACCESS === "none") {
        const details = { available: false, reason: "withheld_by_condition" };
        appendEvent({ event: "test_visible_unavailable", toolCallId, params });
        return {
          content: [
            {
              type: "text",
              text: "Visible tests and their scores are intentionally withheld in this condition. Continue from the specification, local build checks, and tests you author yourself.",
            },
          ],
          details,
        };
      }

      const stage = Math.min(params.stage ?? MAX_STAGE, MAX_STAGE);
      const safeId = toolCallId.replace(/[^a-zA-Z0-9_.-]/g, "_");
      const outputPath = `${ARTIFACTS}/tool-evaluations/${safeId}.json`;
      const args = [
        "/opt/picc-eval/evaluate.py",
        "--workspace",
        "/workspace",
        "--tests-root",
        "/visible-tests",
        "--manifest",
        "/visible-tests/manifest.json",
        "--candidate-config",
        "/opt/picc-eval/candidate.json",
        "--max-stage",
        String(stage),
        "--output",
        outputPath,
        "--summary-json",
      ];
      if (params.latestOnly) args.push("--latest-only");
      if (params.testId) args.push("--test-id", params.testId);

      appendEvent({
        event: "test_visible_start",
        toolCallId,
        params,
        feedbackMode: FEEDBACK_MODE,
        outputPath,
      });
      const result = await run("python3", args, signal);
      let summary: EvaluationSummary;
      try {
        summary = JSON.parse(result.stdout.trim()) as EvaluationSummary;
      } catch {
        summary = {
          score: 0,
          build_ok: false,
          audit_ok: false,
          error: `Evaluator returned non-JSON output (exit ${result.code}): ${result.stderr.slice(0, 2000)}`,
        };
      }
      if (result.code !== 0 && !summary.error) {
        summary.error = `Evaluator exited ${result.code}: ${result.stderr.slice(0, 2000)}`;
      }
      appendEvent({
        event: "test_visible_end",
        toolCallId,
        exitCode: result.code,
        feedbackMode: FEEDBACK_MODE,
        summary,
        stderr: result.stderr.slice(0, 4000),
      });
      return {
        content: [{ type: "text", text: renderSummary(summary, outputPath) }],
        details: summary,
      };
    },
  });

  pi.registerTool({
    name: "reference_oracle",
    label: "Query reference behavior",
    description:
      REFERENCE_MODE === "oracle"
        ? "Compile and execute one self-contained C program with the evaluator-side reference compiler. Returns observable acceptance and behavior only."
        : "Reference-oracle access is unavailable in this experimental condition.",
    promptSnippet:
      REFERENCE_MODE === "oracle" ? "Query observable reference behavior" : "Reference oracle unavailable",
    promptGuidelines:
      REFERENCE_MODE === "oracle"
        ? [
            "Use reference_oracle only to resolve behavior that the specification and visible tests do not establish.",
            "Prefer small, discriminating programs. Oracle calls are limited and fully logged.",
          ]
        : ["Do not repeatedly call this tool; reference-oracle access is intentionally unavailable."],
    parameters: Type.Object({
      source: Type.String({
        maxLength: 50000,
        description: "A complete, self-contained C program whose observable behavior should be queried",
      }),
    }),
    async execute(toolCallId, params, signal) {
      if (REFERENCE_MODE !== "oracle") {
        appendEvent({ event: "reference_oracle_unavailable", toolCallId });
        return {
          content: [
            {
              type: "text",
              text: "Reference implementation behavior is intentionally unavailable in this condition.",
            },
          ],
          details: { available: false, reason: "withheld_by_condition" },
        };
      }

      const priorCount = readOracleCount();
      if (priorCount >= ORACLE_LIMIT) {
        appendEvent({ event: "reference_oracle_limit", toolCallId, count: priorCount, limit: ORACLE_LIMIT });
        return {
          content: [
            {
              type: "text",
              text: `Reference-oracle budget exhausted (${priorCount}/${ORACLE_LIMIT} calls).`,
            },
          ],
          details: { available: false, reason: "budget_exhausted", count: priorCount, limit: ORACLE_LIMIT },
        };
      }

      const count = priorCount + 1;
      atomicJson(ORACLE_COUNT_PATH, { count, limit: ORACLE_LIMIT });
      const safeId = toolCallId.replace(/[^a-zA-Z0-9_.-]/g, "_");
      const queryDir = `${ARTIFACTS}/oracle-queries`;
      mkdirSync(queryDir, { recursive: true });
      const sourcePath = `${queryDir}/${String(count).padStart(4, "0")}-${safeId}.c`;
      const outputPath = `${queryDir}/${String(count).padStart(4, "0")}-${safeId}.json`;
      writeFileSync(sourcePath, params.source, "utf8");

      appendEvent({
        event: "reference_oracle_start",
        toolCallId,
        callIndex: count,
        limit: ORACLE_LIMIT,
        sourcePath,
      });
      const result = await run(
        "python3",
        [
          "/opt/picc-eval/evaluate.py",
          "--workspace",
          "/workspace",
          "--candidate-config",
          "/opt/picc-eval/candidate.json",
          "--oracle-source",
          sourcePath,
          "--output",
          outputPath,
          "--summary-json",
        ],
        signal,
        2 * 60 * 1000,
      );
      let oracle: Record<string, unknown>;
      try {
        oracle = JSON.parse(result.stdout.trim()) as Record<string, unknown>;
      } catch {
        oracle = {
          ok: false,
          failure_type: "oracle_protocol_error",
          detail: `exit ${result.code}: ${result.stderr.slice(0, 2000)}`,
        };
      }
      appendEvent({
        event: "reference_oracle_end",
        toolCallId,
        callIndex: count,
        exitCode: result.code,
        oracle,
      });
      return {
        content: [
          {
            type: "text",
            text: `Reference observation (${count}/${ORACLE_LIMIT}):\n${JSON.stringify(oracle, null, 2)}`,
          },
        ],
        details: { ...oracle, callIndex: count, limit: ORACLE_LIMIT },
      };
    },
  });

  pi.registerTool({
    name: "experiment_status",
    label: "Inspect experiment budget",
    description: "Read the fixed round and time budget without revealing harness-only test scores.",
    promptSnippet: "Inspect fixed experiment budget",
    parameters: Type.Object({}),
    async execute() {
      try {
        const state = JSON.parse(readFileSync(STATE_PATH, "utf8")) as Record<string, unknown>;
        const redacted = { ...state };
        delete redacted.last_visible;
        redacted.test_access = TEST_ACCESS;
        redacted.test_feedback = FEEDBACK_MODE;
        redacted.reference_mode = REFERENCE_MODE;
        redacted.oracle_calls_used = readOracleCount();
        redacted.oracle_calls_limit = REFERENCE_MODE === "oracle" ? ORACLE_LIMIT : 0;
        return {
          content: [{ type: "text", text: JSON.stringify(redacted, null, 2) }],
          details: redacted,
        };
      } catch (error) {
        return {
          content: [
            {
              type: "text",
              text: `No harness state is available yet: ${error instanceof Error ? error.message : String(error)}`,
            },
          ],
          details: {},
        };
      }
    },
  });

  pi.on("session_before_compact", async (event) => {
    appendEvent({
      event: "session_before_compact",
      reason: event.reason,
      willRetry: event.willRetry,
      tokensBefore: event.preparation.tokensBefore,
      firstKeptEntryId: event.preparation.firstKeptEntryId,
    });
  });

  pi.on("session_compact", async (event) => {
    appendEvent({
      event: "session_compact",
      reason: event.reason,
      willRetry: event.willRetry,
      fromExtension: event.fromExtension,
      compactionEntryId: (event.compactionEntry as { id?: string } | undefined)?.id,
    });
  });

  pi.on("after_provider_response", async (event) => {
    if (event.status === 429 || event.status >= 500) {
      appendEvent({
        event: "provider_response_error",
        status: event.status,
        retryAfter: event.headers["retry-after"],
      });
    }
  });
}
